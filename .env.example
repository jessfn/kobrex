# PostgreSQL (en el VPS la base de datos debe llamarse "kobrex")
DATABASE_URL="postgresql://jesus:PASSWORD@localhost:5432/kobrex?schema=public"

# NextAuth
NEXTAUTH_URL="https://kobrex.geodatos.com.mx"
NEXTAUTH_SECRET="generar-con-openssl-rand-base64-32"

# Resend (emails de recordatorio)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Kobrex <notificaciones@geodatos.com.mx>"

# Puerto interno de la app (Nginx hace proxy hacia este puerto)
PORT=14400

# Secreto para proteger /api/cron/reminders (llamado por crontab del sistema)
CRON_SECRET="generar-con-openssl-rand-hex-32"
